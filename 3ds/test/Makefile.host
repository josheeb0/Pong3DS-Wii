# Host builds of the 3DS C code, so both the codec and the netcode can be
# verified without devkitARM or 3DS hardware.
#
#   make -f Makefile.host run    codec conformance vs the TypeScript encoder
#   make -f Makefile.host play   plays a real match against a running server
#
# Warnings are errors here on purpose: this is the cheapest place to catch a
# mistake in code that is awkward to debug on a console.
CC      ?= cc
CFLAGS  := -std=c99 -Wall -Wextra -Werror -O1 -g -fsanitize=address,undefined
LDFLAGS := -fsanitize=address,undefined

PROTO := ../source/net/pong_proto.c
CLIENT := ../source/game/client.c

.PHONY: all run play clean

all: test_proto test_play

test_proto: test_proto.c $(PROTO) ../source/net/pong_proto.h golden_data.h
	$(CC) $(CFLAGS) -o $@ test_proto.c $(PROTO) $(LDFLAGS)

test_play: test_play.c $(PROTO) $(CLIENT) ../source/game/client.h
	$(CC) $(CFLAGS) -I../source/net -I../source/game -o $@ test_play.c $(PROTO) $(CLIENT) $(LDFLAGS)

run: test_proto
	./test_proto

play: test_play
	./test_play $(ARGS)

clean:
	rm -rf test_proto test_play *.dSYM
